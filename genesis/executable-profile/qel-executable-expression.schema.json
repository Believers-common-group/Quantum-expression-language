{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Believers-common-group/Quantum-expression-language/blob/genesis/genesis/executable-profile/qel-executable-expression.schema.json",
  "title": "QEL Genesis Executable Expression",
  "type": "object",
  "additionalProperties": false,
  "required": ["expression_id", "version", "status", "change_id", "name", "execution_mode", "given", "when", "using", "under", "then", "producing", "safety", "lineage"],
  "properties": {
    "expression_id": {"type": "string", "pattern": "^QEL-LNS-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["engineering_baseline", "validated", "superseded"]},
    "change_id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 3},
    "execution_mode": {"const": "declarative_contract"},
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thing_ref", "state", "context_refs"],
      "properties": {
        "thing_ref": {"type": "string", "minLength": 2},
        "state": {"type": ["string", "null"]},
        "context_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "conditions"],
      "properties": {
        "trigger": {"type": "string", "minLength": 2},
        "conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "using": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "method", "inputs"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 2},
        "method": {"type": "string", "minLength": 2},
        "inputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "under": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_refs", "policy_refs", "constraints", "consent_required"],
      "properties": {
        "authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "policy_refs": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "consent_required": {"type": "boolean"}
      }
    },
    "then": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "transformations"],
      "properties": {
        "effect": {"type": "string", "minLength": 2},
        "transformations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "producing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_state", "evidence", "cost", "timestamp_mode", "registry_updates"],
      "properties": {
        "new_state": {"type": "string", "minLength": 2},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accounting_type", "value", "unit"],
          "properties": {
            "accounting_type": {"type": "string", "minLength": 2},
            "value": {"type": ["number", "null"]},
            "unit": {"type": ["string", "null"]}
          }
        },
        "timestamp_mode": {"type": "string", "enum": ["execution_time", "measurement_time", "release_time"]},
        "registry_updates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warden_required", "deterministic_safety_required", "direct_raw_actuation_allowed", "failure_behavior"],
      "properties": {
        "warden_required": {"type": "boolean"},
        "deterministic_safety_required": {"type": "boolean"},
        "direct_raw_actuation_allowed": {"const": false},
        "failure_behavior": {"type": "string", "minLength": 2}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_version", "registry_refs", "supersedes"],
      "properties": {
        "source_ref": {"const": "LENSEOS-SOURCE"},
        "source_version": {"const": "0.1.0"},
        "registry_refs": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": ["string", "null"]}
      }
    }
  }
}
